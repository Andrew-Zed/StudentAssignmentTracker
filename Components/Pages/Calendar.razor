@page "/calendar"

<PageTitle>Calendar - Student Assignment Tracker</PageTitle>

<div class="calendar-page">

    <div class="calendar-header">

        <div>
            <h1>Calendar</h1>
            <p>View your assignments and deadlines on your academic calendar.</p>
        </div>

        <button class="today-button" @onclick="GoToToday">
            Today
        </button>

    </div>

    <div class="calendar-card">

        <div class="calendar-navigation">

            <button class="navigation-button" @onclick="PreviousMonth">
                ←
            </button>

            <h2>@CurrentMonth.ToString("MMMM yyyy")</h2>

            <button class="navigation-button" @onclick="NextMonth">
                →
            </button>

        </div>

        <div class="calendar-weekdays">

            @foreach (var day in WeekDays)
            {
                <div class="weekday">
                    @day
                </div>
            }

        </div>

        <div class="calendar-grid">

            @foreach (var day in CalendarDays)
            {
                <button type="button"
                        class="calendar-day
                        @(day.Date.Month != CurrentMonth.Month ? "other-month" : "")
                        @(day.Date == DateTime.Today ? "today" : "")
                        @(day.Date == SelectedDate ? "selected" : "")"
                        @onclick="() => SelectDate(day.Date)">

                    <span class="day-number">
                        @day.Date.Day
                    </span>

                    @if (GetAssignments(day.Date).Any())
                    {
                        <div class="day-assignments">

                            @foreach (var assignment in GetAssignments(day.Date))
                            {
                                <span class="assignment-dot"
                                      title="@assignment.Title">
                                    @assignment.Title
                                </span>
                            }

                        </div>
                    }

                </button>
            }

        </div>

    </div>

    <div class="selected-date-card">

        <div class="selected-date-header">
            <div>
                <h2>@SelectedDate.ToString("dddd, MMMM d, yyyy")</h2>
                <p>Assignments for this date</p>
            </div>
        </div>

        @if (GetAssignments(SelectedDate).Any())
        {
            <div class="selected-assignment-list">

                @foreach (var assignment in GetAssignments(SelectedDate))
                {
                    <div class="selected-assignment">

                        <div class="assignment-icon">
                            📝
                        </div>

                        <div class="assignment-details">

                            <h3>@assignment.Title</h3>

                            <p>@assignment.Course</p>

                            <span class="priority @assignment.Priority.ToLower()">
                                @assignment.Priority Priority
                            </span>

                        </div>

                        <span class="assignment-status @assignment.Status.ToLower().Replace(" ", "-")">
                            @assignment.Status
                        </span>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-date">

                <div class="empty-icon">
                    📅
                </div>

                <h3>No assignments</h3>

                <p>
                    There are no assignments scheduled for this date.
                </p>

            </div>
        }

    </div>

</div>

@code {

    private DateTime CurrentMonth = new DateTime(
        DateTime.Today.Year,
        DateTime.Today.Month,
        1);

    private DateTime SelectedDate = DateTime.Today;

    private List<CalendarDay> CalendarDays = new();

    private readonly string[] WeekDays =
    {
        "Sun",
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat"
    };

    private List<CalendarAssignment> Assignments = new()
    {
        new CalendarAssignment
        {
            Title = "Connect Four Project",
            Course = "CSE 325",
            DueDate = new DateTime(2026, 10, 2),
            Priority = "High",
            Status = "Upcoming"
        },

        new CalendarAssignment
        {
            Title = "Database Design Assignment",
            Course = "CSE 325",
            DueDate = new DateTime(2026, 10, 6),
            Priority = "Medium",
            Status = "Upcoming"
        },

        new CalendarAssignment
        {
            Title = "Web API Assignment",
            Course = "CSE 325",
            DueDate = new DateTime(2026, 10, 10),
            Priority = "Low",
            Status = "Completed"
        },

        new CalendarAssignment
        {
            Title = "Mobile App Project",
            Course = "CSE 310",
            DueDate = new DateTime(2026, 10, 15),
            Priority = "High",
            Status = "Upcoming"
        }
    };

    protected override void OnInitialized()
    {
        GenerateCalendar();
    }

    private void GenerateCalendar()
    {
        CalendarDays.Clear();

        DateTime firstDayOfMonth = new DateTime(
            CurrentMonth.Year,
            CurrentMonth.Month,
            1);

        int daysBeforeMonth =
            (int)firstDayOfMonth.DayOfWeek;

        DateTime calendarStart =
            firstDayOfMonth.AddDays(-daysBeforeMonth);

        for (int i = 0; i < 42; i++)
        {
            CalendarDays.Add(new CalendarDay
            {
                Date = calendarStart.AddDays(i)
            });
        }
    }

    private void PreviousMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);

        GenerateCalendar();
    }

    private void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);

        GenerateCalendar();
    }

    private void GoToToday()
    {
        CurrentMonth = new DateTime(
            DateTime.Today.Year,
            DateTime.Today.Month,
            1);

        SelectedDate = DateTime.Today;

        GenerateCalendar();
    }

    private void SelectDate(DateTime date)
    {
        SelectedDate = date;
    }

    private IEnumerable<CalendarAssignment> GetAssignments(DateTime date)
    {
        return Assignments.Where(a =>
            a.DueDate.Date == date.Date);
    }

    private class CalendarDay
    {
        public DateTime Date { get; set; }
    }

    private class CalendarAssignment
    {
        public string Title { get; set; } = string.Empty;

        public string Course { get; set; } = string.Empty;

        public DateTime DueDate { get; set; }

        public string Priority { get; set; } = "Medium";

        public string Status { get; set; } = "Upcoming";
    }
}